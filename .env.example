# Copy to .env and fill in. .env is gitignored — never commit a real key.

# ---- Option A: OpenAI API (simplest) --------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for a proxy or gateway

# ---- Option B: Azure / Foundry models ------------------------------------
# Leave OPENAI_API_KEY unset to use this path. Auth is DefaultAzureCredential:
# managed identity when deployed, `az login` locally. No key required.
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Optional ------------------------------------------------------------
PORT=8088
# Injected by Foundry when deployed; set locally only to test OTel export.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
